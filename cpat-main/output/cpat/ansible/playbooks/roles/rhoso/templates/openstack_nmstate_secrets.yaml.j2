{#
  Per-node NMState provisioning network secrets for BareMetalHost.
  Required when Data Plane Provisioning Mode = unprovisioned.
  Each secret contains the YAML network state (dns-resolver, interfaces, routes)
  that Metal3 applies during initial node provisioning boot.

  The BareMetalHost spec.preprovisioningNetworkDataName references these secrets.

  CIQ inputs used:
    - rhoso_nodes[].Node Name, Provisioning NIC, Provisioning VLAN, Provisioning IP
    - rhoso_nodes[].Management IP (for ctlplane route)
    - rhoso_worker_dns_servers / rhoso_dns_upstream_servers
    - rhoso_networks[] (for subnet gateway from ctlplane network)
#}
{% set ctlplane_net = rhoso_networks | selectattr('Network Name', 'equalto', rhoso_mgmt_net) | list | first | default({}) %}
{% set ctlplane_gw = ctlplane_net['Gateway'] | default('') %}
{% set ctlplane_cidr = ctlplane_net['CIDR'] | default('') %}
{% set prefix_len = ctlplane_cidr.split('/')[1] | default('24') if '/' in (ctlplane_cidr | default('')) else '24' %}
{% set dns_servers_str = rhoso_worker_dns_servers | default(rhoso_dns_upstream_servers | default('')) %}
{% for node in rhoso_nodes %}
{% if (node['BMC Address'] | default('') | string) | length > 0 %}
{% set prov_nic = node['Provisioning NIC'] | default(rhoso_edpm_nic1_name) %}
{% set prov_vlan = node['Provisioning VLAN'] | default('') %}
{% set prov_ip = node['Provisioning IP'] | default(node['Management IP'] | default('')) %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ node['Node Name'] }}-nmstate-secret
  namespace: {{ node['BMH Namespace'] | default(rhoso_openstack_ns) }}
type: Opaque
stringData:
  nmstate: |
    ---
{% if dns_servers_str | length > 0 %}
    dns-resolver:
      config:
        server:
{% for srv in dns_servers_str.split(',') %}
          - {{ srv | trim }}
{% endfor %}
{% endif %}
    interfaces:
      - name: {{ prov_nic }}
        type: ethernet
        state: up
        ipv4:
          enabled: false
{% if prov_vlan | length > 0 %}
      - name: vlan{{ prov_vlan }}
        type: vlan
        state: up
        vlan:
          base-iface: {{ prov_nic }}
          id: {{ prov_vlan }}
        ipv4:
          enabled: true
          address:
            - ip: {{ prov_ip }}
              prefix-length: {{ prefix_len }}
{% else %}
      - name: {{ prov_nic }}
        type: ethernet
        state: up
        ipv4:
          enabled: true
          address:
            - ip: {{ prov_ip }}
              prefix-length: {{ prefix_len }}
{% endif %}
{% if ctlplane_gw | length > 0 %}
    routes:
      config:
        - destination: 0.0.0.0/0
          next-hop-address: {{ ctlplane_gw }}
{% if prov_vlan | length > 0 %}
          next-hop-interface: vlan{{ prov_vlan }}
{% else %}
          next-hop-interface: {{ prov_nic }}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
