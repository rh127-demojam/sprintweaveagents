; DNS zone file for {{ ocp_cluster_name }}.{{ ocp_base_domain }} — generated by CPAT
;
; Required DNS records for OCP cluster
; Import this into your BIND/dnsmasq zone or configure equivalent A/PTR records
;
$ORIGIN {{ ocp_cluster_name }}.{{ ocp_base_domain }}.

; API endpoint
api    IN  A  {{ ocp_api_vip }}
api-int    IN  A  {{ ocp_api_vip }}

; Wildcard ingress
*.apps    IN  A  {{ ocp_ingress_vip }}

{% if ocp_dns_records | default([]) | length > 0 %}
; Host records from CIQ
{% for rec in ocp_dns_records %}
{{ rec['Hostname'] | default('unknown') }}    IN  {{ rec['Record Type'] }}  {{ rec['IP or Target'] }}
{% endfor %}
{% endif %}
