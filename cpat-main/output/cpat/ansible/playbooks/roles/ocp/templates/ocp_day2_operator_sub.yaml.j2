---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: {{ operator_name }}
  namespace: {{ ocp_operator_namespaces[operator_name] | default('openshift-' + operator_name) }}
spec:
  channel: {{ ocp_operator_channels[operator_name] | default('stable') }}
  installPlanApproval: Automatic
  name: {{ operator_name }}
  source: {{ ocp_operator_catalog | default('redhat-operators') }}
  sourceNamespace: openshift-marketplace
{% if ocp_is_disconnected | bool and ocp_catalogsource_name | default('') | length > 0 %}
  source: {{ ocp_catalogsource_name }}
{% endif %}
