# HAProxy load balancer config for OCP — generated by CPAT
# Binds to API/Ingress VIPs to avoid conflicts with other services on bastion

global
    log 127.0.0.1 local2
    maxconn 4000
    daemon

defaults
    mode tcp
    log global
    timeout connect 10s
    timeout client  300s
    timeout server  300s

{% set _api_vip = ocp_api_vip if (ocp_api_vip | default('') | length > 0) else (ocp_api_vip_platform_none | default('*')) %}
{% set _ingress_vip = ocp_ingress_vip if (ocp_ingress_vip | default('') | length > 0) else '*' %}
{% set _api_port = ocp_api_server_port | default(6443) %}
{% set _mcs_port = ocp_mcs_port | default(22623) %}
{% set _https_port = ocp_ingress_https_port | default(443) %}
{% set _http_port = ocp_ingress_http_port | default(80) %}
frontend kubernetes_api
    bind {{ _api_vip }}:{{ _api_port }}
    default_backend kubernetes_api_backend

backend kubernetes_api_backend
    balance roundrobin
{% for host in ocp_bmc_hosts | default([]) %}
{% if host.Role | lower in ['master', 'control-plane'] %}
{% set _ip = (ocp_nmstate_interfaces | default([]) | selectattr('Hostname', 'equalto', host.Hostname) | map(attribute='IPv4 Address') | first) | default(host.Hostname) %}
    server {{ host.Hostname }} {{ _ip }}:{{ _api_port }} check
{% endif %}
{% endfor %}

frontend machine_config
    bind {{ _api_vip }}:{{ _mcs_port }}
    default_backend machine_config_backend

backend machine_config_backend
    balance roundrobin
{% for host in ocp_bmc_hosts | default([]) %}
{% if host.Role | lower in ['master', 'control-plane'] %}
{% set _ip = (ocp_nmstate_interfaces | default([]) | selectattr('Hostname', 'equalto', host.Hostname) | map(attribute='IPv4 Address') | first) | default(host.Hostname) %}
    server {{ host.Hostname }} {{ _ip }}:{{ _mcs_port }} check
{% endif %}
{% endfor %}

frontend ingress_https
    bind {{ _ingress_vip }}:{{ _https_port }}
    default_backend ingress_https_backend

backend ingress_https_backend
    balance roundrobin
{% for host in ocp_bmc_hosts | default([]) %}
{% if host.Role | lower == 'worker' %}
{% set _ip = (ocp_nmstate_interfaces | default([]) | selectattr('Hostname', 'equalto', host.Hostname) | map(attribute='IPv4 Address') | first) | default(host.Hostname) %}
    server {{ host.Hostname }} {{ _ip }}:{{ _https_port }} check
{% endif %}
{% endfor %}

frontend ingress_http
    bind {{ _ingress_vip }}:{{ _http_port }}
    default_backend ingress_http_backend

backend ingress_http_backend
    balance roundrobin
{% for host in ocp_bmc_hosts | default([]) %}
{% if host.Role | lower == 'worker' %}
{% set _ip = (ocp_nmstate_interfaces | default([]) | selectattr('Hostname', 'equalto', host.Hostname) | map(attribute='IPv4 Address') | first) | default(host.Hostname) %}
    server {{ host.Hostname }} {{ _ip }}:{{ _http_port }} check
{% endif %}
{% endfor %}
