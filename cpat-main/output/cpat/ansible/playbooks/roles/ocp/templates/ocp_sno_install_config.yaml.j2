apiVersion: v1
baseDomain: {{ ocp_base_domain }}
compute:
- architecture: {{ ocp_architecture }}
  hyperthreading: {{ ocp_hyperthreading | default('Enabled') }}
  name: worker
  replicas: 0
controlPlane:
  architecture: {{ ocp_architecture }}
  hyperthreading: {{ ocp_hyperthreading | default('Enabled') }}
  name: master
  replicas: 1
metadata:
  name: {{ ocp_cluster_name }}
networking:
  clusterNetwork:
  - cidr: {{ ocp_cluster_network_cidr }}
    hostPrefix: {{ ocp_cluster_network_host_prefix }}
  machineNetwork:
  - cidr: {{ ocp_machine_network_cidr }}
  networkType: {{ ocp_network_type }}
  serviceNetwork:
  - {{ ocp_service_network_cidr }}
platform:
  none: {}
{% if ocp_fips_mode | bool %}
fips: true
{% endif %}
pullSecret: '{{ ocp_pull_secret_decoded }}'
sshKey: '{{ ocp_ssh_key_decoded }}'
{% if ocp_is_disconnected | bool and ocp_trust_bundle_decoded | default('') | length > 0 %}
additionalTrustBundle: |
{{ ocp_trust_bundle_decoded | indent(2, true) }}
imageContentSources:
{% if ocp_image_content_source_1 | default('') | length > 0 %}
- mirrors:
  - {{ ocp_image_content_mirror_1 }}
  source: {{ ocp_image_content_source_1 }}
{% endif %}
{% endif %}
