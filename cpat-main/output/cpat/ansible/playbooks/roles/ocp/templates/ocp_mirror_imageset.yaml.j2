---
apiVersion: mirror.openshift.io/v2alpha1
kind: ImageSetConfiguration
mirror:
  platform:
    channels:
    - name: "stable-{{ ocp_version }}"
      type: ocp
      minVersion: "{{ ocp_version ~ '.0' if ocp_version.split('.') | length < 3 else ocp_version }}"
      maxVersion: "{{ ocp_version ~ '.0' if ocp_version.split('.') | length < 3 else ocp_version }}"
    graph: false
{% if ocp_day2_operators_to_install | default([]) | length > 0 %}
  operators:
  - catalog: "registry.redhat.io/redhat/redhat-operator-index:v{{ ocp_version }}"
    packages:
{% for op in ocp_day2_operators_to_install %}
    - name: {{ op }}
{% endfor %}
{% endif %}
  additionalImages: []
  helm: {}
