# Docling base image — rebuild RARELY (hours, multi-GB).
#
# From CFP_NEW:
#   podman build -f sprintweave-web/Dockerfile.docling-base \
#     -t quay.io/YOUR_ORG/sprintweave-docling-base:latest .
#   podman push quay.io/YOUR_ORG/sprintweave-docling-base:latest
#
# Then build thin app images with Dockerfile.bundle FROM this base.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/app \
    PIP_TRUSnTED_HOST="pypi.org pypi.python.org files.pythonhosted.org" \
    # HuggigFace / Docling model cache inside the image
    HF_HOME=/opt/docling-cache \
    TRANSFORMERS_CACHE=/opt/docling-cache \
    DOCLING_CACHE_DIR=/opt/docling-cache

RUN groupadd -g 1001 appuser \
    && useradd -m -u 1001 -g 1001 -s /bin/bash appuser \
    && mkdir -p /opt/docling-cache /app /data \
    && chown -R appuser:appuser /opt/docling-cache /app /data

WORKDIR /app

COPY sprintweave-web/requirements-docling.txt /tmp/requirements-docling.txt

# Optional OS libs some PDF stacks need
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir \
        --trusted-host pypi.org \
        --trusted-host pypi.python.org \
        --trusted-host files.pythonhosted.org \
        -r /tmp/requirements-docling.txt

# Warm Docling import so layers fail early if install is broken
RUN python -c "from docling.document_converter import DocumentConverter; print('docling-ok')"

USER 1001

LABEL sprintweave.component="docling-base" \
      sprintweave.note="Use as BASE_IMAGE for Dockerfile.bundle"
